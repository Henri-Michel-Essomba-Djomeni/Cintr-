<UserControl x:Class="Cintre.App.Views.ClientsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Cintre.App.Controls">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>

        <!-- Message d'erreur sous un champ : disparaît quand il est vide -->
        <Style x:Key="ErreurChamp" TargetType="TextBlock" BasedOn="{StaticResource MessageErreur}">
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Légende qui disparaît quand elle est vide -->
        <Style x:Key="LegendeAuto" TargetType="TextBlock" BasedOn="{StaticResource Legende}">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Carte de la liste : contour orange quand elle est sélectionnée -->
        <Style x:Key="CarteClient" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="cadre" BorderThickness="2" BorderBrush="Transparent"
                                CornerRadius="14" Padding="3">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="cadre" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Clients" Style="{StaticResource TitrePage}"/>
            <TextBlock Text="Retrouvez un client, suivez ses points de fidélité et ses commandes."
                       Style="{StaticResource Legende}" Margin="0,4,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="520"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="440"/>
            </Grid.ColumnDefinitions>

            <!-- ================= GAUCHE : recherche + cartes ================= -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <TextBox Style="{StaticResource ChampTexte}"
                                 Text="{Binding Recherche, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Rechercher un nom ou un téléphone…" Style="{StaticResource Legende}"
                                   FontSize="14" Margin="14,0,0,0" VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Visibility="{Binding IndiceVisible, Converter={StaticResource BoolVis}}"/>
                    </Grid>
                    <Button Grid.Column="1" Content="+ Nouveau" Margin="12,0,0,0"
                            Style="{StaticResource BoutonPrimaire}"
                            Command="{Binding NouveauCommand}"/>
                </Grid>

                <ListBox Grid.Row="1" ItemsSource="{Binding Clients}"
                         SelectedItem="{Binding Selection, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource CarteClient}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <controls:FolderCard Nom="{Binding Nom}" Telephone="{Binding Telephone}"
                                                 Points="{Binding PointsFidelite}"
                                                 NbCommandes="{Binding NbCommandes}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Grid.Row="1" Text="Aucun client trouvé." Style="{StaticResource Legende}"
                           FontSize="14" Margin="4,8,0,0" VerticalAlignment="Top"
                           Visibility="{Binding AucunResultat, Converter={StaticResource BoolVis}}"/>
            </Grid>

            <!-- ================= DROITE : fiche du client ================= -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <Border Style="{StaticResource Carte}" VerticalAlignment="Top" Margin="0,0,4,8">
                    <StackPanel>
                        <TextBlock Text="{Binding TitreFiche}" Style="{StaticResource TitreCarte}"
                                   TextTrimming="CharacterEllipsis"/>

                        <TabControl Margin="0,12,0,0">

                            <!-- Onglet Informations -->
                            <TabItem Header="Informations">
                                <StackPanel>
                                    <TextBlock Text="Nom *" Style="{StaticResource Legende}"/>
                                    <TextBox Style="{StaticResource ChampTexte}" Margin="0,4,0,0"
                                             Text="{Binding Nom, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="{Binding ErreurNom}" Style="{StaticResource ErreurChamp}"/>

                                    <TextBlock Text="Téléphone *" Style="{StaticResource Legende}" Margin="0,14,0,0"/>
                                    <TextBox Style="{StaticResource ChampTexte}" Margin="0,4,0,0"
                                             Text="{Binding Telephone, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="{Binding ErreurTelephone}" Style="{StaticResource ErreurChamp}"/>

                                    <TextBlock Text="E-mail" Style="{StaticResource Legende}" Margin="0,14,0,0"/>
                                    <TextBox Style="{StaticResource ChampTexte}" Margin="0,4,0,0"
                                             Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>

                                    <TextBlock Text="Adresse" Style="{StaticResource Legende}" Margin="0,14,0,0"/>
                                    <TextBox Style="{StaticResource ChampTexte}" Margin="0,4,0,0"
                                             Text="{Binding Adresse, UpdateSourceTrigger=PropertyChanged}"/>

                                    <!-- Fidélité -->
                                    <Border Background="{StaticResource SurvolBrush}" CornerRadius="10"
                                            Padding="16" Margin="0,20,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Points de fidélité" Style="{StaticResource Legende}"/>
                                            <TextBlock Text="{Binding Points}" FontSize="28" FontWeight="SemiBold"
                                                       Foreground="{StaticResource PrimaireBrush}"/>
                                            <TextBlock Text="{Binding TexteFidelite}" TextWrapping="Wrap"
                                                       Margin="0,4,0,0" FontSize="13">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource TexteBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding EstEligible}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource SuccesBrush}"/>
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                                        <Button Content="Enregistrer" Style="{StaticResource BoutonPrimaire}"
                                                Command="{Binding EnregistrerCommand}"/>
                                        <Button Content="Supprimer" Style="{StaticResource BoutonDanger}"
                                                Margin="12,0,0,0" Command="{Binding SupprimerCommand}"
                                                Visibility="{Binding PeutSupprimer, Converter={StaticResource BoolVis}}"/>
                                    </StackPanel>
                                </StackPanel>
                            </TabItem>

                            <!-- Onglet Historique -->
                            <TabItem Header="Historique">
                                <StackPanel>
                                    <TextBlock Text="{Binding MessageHistorique}" Style="{StaticResource LegendeAuto}"
                                               FontSize="13" Margin="0,4,0,0"/>

                                    <DataGrid ItemsSource="{Binding Historique}" MaxHeight="380"
                                              HeadersVisibility="Column"
                                              VerticalScrollBarVisibility="Auto"
                                              Visibility="{Binding HistoriqueDisponible, Converter={StaticResource BoolVis}}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Ticket" Width="1.3*"
                                                                Binding="{Binding NumeroTicket}"/>
                                            <DataGridTextColumn Header="Date" Width="*"
                                                                Binding="{Binding DateDepot, StringFormat=dd/MM/yyyy}"/>
                                            <DataGridTemplateColumn Header="Statut" Width="1.3*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border>
                                                            <Border.Style>
                                                                <Style TargetType="Border" BasedOn="{StaticResource Badge}">
                                                                    <Setter Property="Background" Value="{StaticResource StatutRecuBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Statut}" Value="EnTraitement">
                                                                            <Setter Property="Background" Value="{StaticResource StatutTraitementBrush}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Statut}" Value="Pret">
                                                                            <Setter Property="Background" Value="{StaticResource StatutPretBrush}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Statut}" Value="Retire">
                                                                            <Setter Property="Background" Value="{StaticResource StatutRetireBrush}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Statut}" Value="Annule">
                                                                            <Setter Property="Background" Value="{StaticResource StatutAnnuleBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock>
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource BadgeTexte}">
                                                                        <Setter Property="Text" Value="Reçu"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Statut}" Value="EnTraitement">
                                                                                <Setter Property="Text" Value="En traitement"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Statut}" Value="Pret">
                                                                                <Setter Property="Text" Value="Prêt"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Statut}" Value="Retire">
                                                                                <Setter Property="Text" Value="Retiré"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Statut}" Value="Annule">
                                                                                <Setter Property="Text" Value="Annulé"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Total" Width="1.2*"
                                                                Binding="{Binding MontantTotal, StringFormat='{}{0:N0} FCFA', ConverterCulture=fr-FR}"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </TabItem>
                        </TabControl>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
