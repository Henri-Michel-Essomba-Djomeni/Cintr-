<UserControl x:Class="Cintre.App.Views.CommandesView"
             Language="fr-FR"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Cintre.App.Controls"
             xmlns:local="clr-namespace:Cintre.App.Views">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <local:StatutTexteConverter x:Key="StatutTexte"/>
        <local:PhotoConverter x:Key="PhotoImg"/>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Commandes" Style="{StaticResource TitrePage}"/>

        <!-- Barre d'outils : WrapPanel pour ne pas déborder à 1100 px de large -->
        <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16">
            <Grid Margin="0,0,8,8">
                <TextBox Width="260" Height="40"
                         Style="{StaticResource ChampTexte}"
                         Text="{Binding Texte, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Rechercher un ticket ou un client" Foreground="Gray"
                           IsHitTestVisible="False" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Texte}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <Button Content="Tous" Height="40" Margin="0,0,8,8"
                    Style="{StaticResource BoutonSecondaire}"
                    Command="{Binding FiltrerStatutCommand}" CommandParameter="Tous"/>
            <Button Content="Reçu" Height="40" Margin="0,0,8,8"
                    Style="{StaticResource BoutonSecondaire}"
                    Command="{Binding FiltrerStatutCommand}" CommandParameter="Recu"/>
            <Button Content="En traitement" Height="40" Margin="0,0,8,8"
                    Style="{StaticResource BoutonSecondaire}"
                    Command="{Binding FiltrerStatutCommand}" CommandParameter="EnTraitement"/>
            <Button Content="Prêt" Height="40" Margin="0,0,8,8"
                    Style="{StaticResource BoutonSecondaire}"
                    Command="{Binding FiltrerStatutCommand}" CommandParameter="Pret"/>
            <Button Content="Retiré" Height="40" Margin="0,0,8,8"
                    Style="{StaticResource BoutonSecondaire}"
                    Command="{Binding FiltrerStatutCommand}" CommandParameter="Retire"/>
            <CheckBox Content="En retard seulement" Margin="8,0,0,8"
                      VerticalAlignment="Center"
                      Style="{StaticResource CaseCocher}"
                      IsChecked="{Binding SeulementRetard}"/>
        </WrapPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Colonnes en étoiles avec largeurs minimales -->
            <DataGrid ItemsSource="{Binding Commandes}" SelectedItem="{Binding Selection, Mode=TwoWay}"
                      AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="TICKET" Binding="{Binding NumeroTicket}" Width="2*" MinWidth="175"/>
                    <DataGridTextColumn Header="CLIENT" Binding="{Binding ClientNom}" Width="1.3*" MinWidth="100"/>

                    <!-- Date prévue en rouge quand la commande est en retard -->
                    <DataGridTemplateColumn Header="PRÉVUE" Width="1.4*" MinWidth="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DatePrevue, StringFormat=dd/MM/yyyy}"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding EnRetard}" Value="True">
                                                    <Setter Property="Foreground" Value="#D64545"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="TOTAL" Binding="{Binding MontantTotal, StringFormat={}{0:N0}, ConverterCulture=fr-FR}" Width="0.8*" MinWidth="75"/>
                    <DataGridTextColumn Header="RESTE" Binding="{Binding Reste, StringFormat={}{0:N0}, ConverterCulture=fr-FR}" Width="0.8*" MinWidth="75"/>

                    <!-- Badge arrondi coloré selon le statut (couleurs de la section 9.1) -->
                    <DataGridTemplateColumn Header="STATUT" Width="1.6*" MinWidth="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource Badge}">
                                            <Setter Property="Background" Value="#6B7280"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Statut}" Value="Recu">
                                                    <Setter Property="Background" Value="#3B82F6"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Statut}" Value="EnTraitement">
                                                    <Setter Property="Background" Value="#F59E0B"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Statut}" Value="Pret">
                                                    <Setter Property="Background" Value="#2E9E5B"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Statut}" Value="Retire">
                                                    <Setter Property="Background" Value="#6B7280"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Statut}" Value="Annule">
                                                    <Setter Property="Background" Value="#D64545"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Statut, Converter={StaticResource StatutTexte}}"
                                               Style="{StaticResource BadgeTexte}" Foreground="White"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <controls:EmptyState Titre="Aucune commande" Message="Aucune commande ne correspond à ta recherche."
                                 Visibility="{Binding AucuneCommande, Converter={StaticResource BoolVis}}"/>

            <!-- Panneau de détail : carte blanche avec ombre douce -->
            <Border Grid.Column="1" Width="310" Margin="16,0,0,0" Padding="16" CornerRadius="12" Background="White"
                    Visibility="{Binding AUneSelection, Converter={StaticResource BoolVis}}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.08" Color="#1F2D3D"/>
                </Border.Effect>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding Detail.NumeroTicket}" Style="{StaticResource TitreCarte}"/>
                        <TextBlock Text="{Binding Detail.ClientNom}" Style="{StaticResource Legende}"/>
                        <controls:ConveyorStatus Statut="{Binding Detail.Statut}" Margin="0,12"/>

                        <!-- Badge rouge qui pulse quand la commande est en retard -->
                        <Border Style="{StaticResource Badge}" Background="#D64545"
                                HorizontalAlignment="Left" Margin="0,0,0,8"
                                Visibility="{Binding Detail.EnRetard, Converter={StaticResource BoolVis}}"
                                Loaded="BadgeRetard_Loaded">
                            <TextBlock Text="En retard" Style="{StaticResource BadgeTexte}" Foreground="White"/>
                        </Border>

                        <TextBlock Text="ARTICLES" Style="{StaticResource Legende}" Margin="0,12,0,4"/>
                        <ItemsControl ItemsSource="{Binding Detail.Lignes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Image Source="{Binding Photo, Converter={StaticResource PhotoImg}}"
                                               Width="48" Height="48" Stretch="UniformToFill" Margin="0,0,8,0">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Photo}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap">
                                            <Run Text="{Binding Quantite, Mode=OneWay}"/><Run Text=" x "/>
                                            <Run Text="{Binding TypeVetementNom, Mode=OneWay}"/><Run Text=" · "/>
                                            <Run Text="{Binding ServiceNom, Mode=OneWay}"/>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{Binding Detail.MontantTotal, StringFormat='Total : {0:N0} FCFA'}" FontWeight="SemiBold" Margin="0,12,0,0"/>
                        <TextBlock Text="{Binding Detail.Reste, StringFormat='Reste à payer : {0:N0} FCFA'}"/>

                        <TextBlock Text="HISTORIQUE" Style="{StaticResource Legende}" Margin="0,12,0,4"/>
                        <ItemsControl ItemsSource="{Binding Historique}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="0,2">
                                        <Run Text="{Binding DateChangement, StringFormat=dd/MM HH:mm, Mode=OneWay}"/><Run Text=" · "/>
                                        <Run Text="{Binding NouveauStatut, Converter={StaticResource StatutTexte}, Mode=OneWay}"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Content="{Binding TexteBoutonSuivant}" Height="40" Margin="0,16,0,0"
                                Style="{StaticResource BoutonPrimaire}"
                                Command="{Binding PasserSuivantCommand}"
                                Visibility="{Binding PeutPasserSuivant, Converter={StaticResource BoolVis}}"/>
                        <Button Content="Annuler la commande" Height="40" Margin="0,8,0,0"
                                Style="{StaticResource BoutonDanger}"
                                Command="{Binding AnnulerCommand}"
                                Visibility="{Binding PeutAnnuler, Converter={StaticResource BoolVis}}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
