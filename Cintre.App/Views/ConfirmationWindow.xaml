<Window x:Class="Cintre.App.Views.ConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="14">
    <Border Margin="24" Background="White" CornerRadius="16" Padding="28">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="4" Opacity="0.25" Color="#000000"/>
        </Border.Effect>
        <StackPanel Width="360">
            <TextBlock Text="Confirmation" Style="{StaticResource TitreCarte}"/>
            <TextBlock x:Name="TxtMessage" Margin="0,10,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource TexteBrush}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button Content="Annuler" Style="{StaticResource BoutonSecondaire}" IsCancel="True"/>
                <Button x:Name="BtnOui" Margin="10,0,0,0" IsDefault="True" Click="Oui_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>