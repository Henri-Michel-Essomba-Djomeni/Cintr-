<UserControl x:Class="Cintre.App.Views.UtilisateursView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Cintre.App.Controls">

	<UserControl.Resources>
		<BooleanToVisibilityConverter x:Key="BoolVis"/>
	</UserControl.Resources>

	<ScrollViewer VerticalScrollBarVisibility="Auto">
		<Grid Margin="0,0,0,24">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="24"/>
				<ColumnDefinition Width="360"/>
			</Grid.ColumnDefinitions>

			<TextBlock Text="Utilisateurs" Style="{StaticResource TitrePage}"
                       Grid.ColumnSpan="3" Margin="0,0,0,24"/>

			<!-- ===== Tableau des utilisateurs ===== -->
			<Border Grid.Row="1" Style="{StaticResource Carte}" VerticalAlignment="Top">
				<StackPanel>
					<DataGrid ItemsSource="{Binding Utilisateurs}"
                              SelectedItem="{Binding Selection, Mode=TwoWay}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              CanUserDeleteRows="False" CanUserResizeRows="False" CanUserReorderColumns="False"
                              GridLinesVisibility="None" HeadersVisibility="Column" RowHeight="48"
                              Background="Transparent" BorderThickness="0" SelectionMode="Single"
                              ScrollViewer.VerticalScrollBarVisibility="Disabled"
                              ColumnHeaderStyle="{StaticResource EnTeteColonne}"
                              RowStyle="{StaticResource LigneTableau}"
                              CellStyle="{StaticResource CelluleTableau}">
						<DataGrid.Columns>
							<DataGridTextColumn Header="Nom" Binding="{Binding Nom}" Width="2*"/>
							<DataGridTextColumn Header="Login" Binding="{Binding Login}" Width="2*"/>
							<DataGridTextColumn Header="Rôle" Binding="{Binding Role}" Width="*"/>
							<DataGridTemplateColumn Header="Statut" Width="*">
								<DataGridTemplateColumn.CellTemplate>
									<DataTemplate>
										<Border VerticalAlignment="Center">
											<Border.Style>
												<Style TargetType="Border" BasedOn="{StaticResource Badge}">
													<Setter Property="Background" Value="{StaticResource DangerBrush}"/>
													<Style.Triggers>
														<DataTrigger Binding="{Binding Actif}" Value="True">
															<Setter Property="Background" Value="{StaticResource SuccesBrush}"/>
														</DataTrigger>
													</Style.Triggers>
												</Style>
											</Border.Style>
											<TextBlock>
												<TextBlock.Style>
													<Style TargetType="TextBlock" BasedOn="{StaticResource BadgeTexte}">
														<Setter Property="Text" Value="Désactivé"/>
														<Style.Triggers>
															<DataTrigger Binding="{Binding Actif}" Value="True">
																<Setter Property="Text" Value="Actif"/>
															</DataTrigger>
														</Style.Triggers>
													</Style>
												</TextBlock.Style>
											</TextBlock>
										</Border>
									</DataTemplate>
								</DataGridTemplateColumn.CellTemplate>
							</DataGridTemplateColumn>
						</DataGrid.Columns>
					</DataGrid>

					<controls:EmptyState Icone="{StaticResource IconInfo}"
                                         Titre="Aucun utilisateur"
                                         Message="Crée un premier compte avec le formulaire à droite."
                                         Visibility="{Binding SansUtilisateur, Converter={StaticResource BoolVis}}"/>
				</StackPanel>
			</Border>

			<!-- ===== Colonne de droite ===== -->
			<StackPanel Grid.Row="1" Grid.Column="2">

				<Border Style="{StaticResource Carte}" Margin="0,0,0,16">
					<StackPanel>
						<TextBlock Text="Compte" Style="{StaticResource TitreCarte}" Margin="0,0,0,16"/>

						<TextBlock Text="Nom" Style="{StaticResource Legende}" Margin="0,0,0,8"/>
						<TextBox Style="{StaticResource ChampTexte}"
                                 Text="{Binding Nom, UpdateSourceTrigger=PropertyChanged}"/>

						<TextBlock Text="Login (fixé à la création)" Style="{StaticResource Legende}" Margin="0,16,0,8"/>
						<TextBox Style="{StaticResource ChampTexte}" IsEnabled="{Binding NouveauCompte}"
                                 Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}"/>

						<TextBlock Text="Rôle" Style="{StaticResource Legende}" Margin="0,16,0,8"/>
						<ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding Role}" MinHeight="40"/>

						<TextBlock Text="Mot de passe (nouveau compte ou réinitialisation)"
                                   Style="{StaticResource Legende}" TextWrapping="Wrap" Margin="0,16,0,8"/>
						<PasswordBox x:Name="MdpForm" Style="{StaticResource ChampMotDePasse}"/>

						<StackPanel Orientation="Horizontal" Margin="0,24,0,0">
							<Button Content="Nouveau" Style="{StaticResource BoutonSecondaire}"
                                    Command="{Binding NouveauCommand}"/>
							<Button Content="Enregistrer" Style="{StaticResource BoutonPrimaire}"
                                    Margin="8,0,0,0" Command="{Binding EnregistrerCommand}"/>
						</StackPanel>
						<Button Content="{Binding TexteBasculer}" Style="{StaticResource BoutonSecondaire}"
                                Margin="0,8,0,0" Command="{Binding BasculerEtatCommand}"/>
						<Button Content="Réinitialiser le mot de passe" Style="{StaticResource BoutonSecondaire}"
                                Margin="0,8,0,0" Command="{Binding ReinitialiserCommand}"/>
					</StackPanel>
				</Border>

				<Border Style="{StaticResource Carte}" Margin="0,0,0,16">
					<StackPanel>
						<TextBlock Text="Changer mon mot de passe" Style="{StaticResource TitreCarte}" Margin="0,0,0,16"/>

						<TextBlock Text="Ancien mot de passe" Style="{StaticResource Legende}" Margin="0,0,0,8"/>
						<PasswordBox x:Name="MdpAncien" Style="{StaticResource ChampMotDePasse}"/>

						<TextBlock Text="Nouveau mot de passe" Style="{StaticResource Legende}" Margin="0,16,0,8"/>
						<PasswordBox x:Name="MdpNouveau" Style="{StaticResource ChampMotDePasse}"/>

						<TextBlock Text="Confirmer le nouveau mot de passe" Style="{StaticResource Legende}" Margin="0,16,0,8"/>
						<PasswordBox x:Name="MdpConfirmation" Style="{StaticResource ChampMotDePasse}"/>

						<Button Content="Changer mon mot de passe" Style="{StaticResource BoutonSecondaire}"
                                Margin="0,24,0,0" Command="{Binding ChangerMonMotDePasseCommand}"/>
					</StackPanel>
				</Border>

				<TextBlock Style="{StaticResource MessageErreur}" Text="{Binding MessageErreur}"/>
			</StackPanel>
		</Grid>
	</ScrollViewer>
</UserControl>