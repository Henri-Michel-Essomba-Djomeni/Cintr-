<UserControl x:Class="Cintre.App.Views.UtilisateursView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="360"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Utilisateurs" Style="{StaticResource TitrePage}"
                   Grid.ColumnSpan="3" Margin="0,0,0,20"/>

        <!-- Tableau des utilisateurs -->
        <Border Grid.Row="1" Style="{StaticResource Carte}" Padding="8" VerticalAlignment="Top">
            <DataGrid ItemsSource="{Binding Utilisateurs}"
                      SelectedItem="{Binding Selection, Mode=TwoWay}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" CanUserAddRows="False"
                      HeadersVisibility="Column" GridLinesVisibility="None"
                      Background="White" BorderThickness="0" RowHeight="36">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nom" Binding="{Binding Nom}" Width="*"/>
                    <DataGridTextColumn Header="Login" Binding="{Binding Login}" Width="*"/>
                    <DataGridTextColumn Header="Rôle" Binding="{Binding Role}" Width="100"/>
                    <DataGridCheckBoxColumn Header="Actif" Binding="{Binding Actif, Mode=OneWay}" Width="70"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Colonne de droite : formulaire et changement de mot de passe -->
        <ScrollViewer Grid.Row="1" Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <Border Style="{StaticResource Carte}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Compte" Style="{StaticResource TitreCarte}" Margin="0,0,0,14"/>

                        <TextBlock Text="Nom" Style="{StaticResource Legende}" Margin="0,0,0,6"/>
                        <TextBox Style="{StaticResource ChampTexte}"
                                 Text="{Binding Nom, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Login (fixé à la création)" Style="{StaticResource Legende}" Margin="0,12,0,6"/>
                        <TextBox Style="{StaticResource ChampTexte}" IsEnabled="{Binding NouveauCompte}"
                                 Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Rôle" Style="{StaticResource Legende}" Margin="0,12,0,6"/>
                        <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding Role}" MinHeight="40"/>

                        <TextBlock Text="Mot de passe (nouveau compte ou réinitialisation)"
                                   Style="{StaticResource Legende}" TextWrapping="Wrap" Margin="0,12,0,6"/>
                        <PasswordBox x:Name="MdpForm" Style="{StaticResource ChampMotDePasse}"/>

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Content="Nouveau" Style="{StaticResource BoutonSecondaire}"
                                    Command="{Binding NouveauCommand}"/>
                            <Button Content="Enregistrer" Style="{StaticResource BoutonPrimaire}"
                                    Margin="8,0,0,0" Command="{Binding EnregistrerCommand}"/>
                        </StackPanel>
                        <Button Content="{Binding TexteBasculer}" Style="{StaticResource BoutonSecondaire}"
                                Margin="0,8,0,0" Command="{Binding BasculerEtatCommand}"/>
                        <Button Content="Réinitialiser le mot de passe" Style="{StaticResource BoutonSecondaire}"
                                Margin="0,8,0,0" Command="{Binding ReinitialiserCommand}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Carte}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Changer mon mot de passe" Style="{StaticResource TitreCarte}" Margin="0,0,0,14"/>

                        <TextBlock Text="Ancien mot de passe" Style="{StaticResource Legende}" Margin="0,0,0,6"/>
                        <PasswordBox x:Name="MdpAncien" Style="{StaticResource ChampMotDePasse}"/>

                        <TextBlock Text="Nouveau mot de passe" Style="{StaticResource Legende}" Margin="0,12,0,6"/>
                        <PasswordBox x:Name="MdpNouveau" Style="{StaticResource ChampMotDePasse}"/>

                        <TextBlock Text="Confirmer le nouveau mot de passe" Style="{StaticResource Legende}" Margin="0,12,0,6"/>
                        <PasswordBox x:Name="MdpConfirmation" Style="{StaticResource ChampMotDePasse}"/>

                        <Button Content="Changer mon mot de passe" Style="{StaticResource BoutonSecondaire}"
                                Margin="0,16,0,0" Command="{Binding ChangerMonMotDePasseCommand}"/>
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource MessageErreur}" Text="{Binding MessageErreur}"/>
                <TextBlock Style="{StaticResource Legende}" Foreground="{StaticResource SuccesBrush}"
                           FontWeight="SemiBold" TextWrapping="Wrap" Margin="2,4,0,0"
                           Text="{Binding MessageSucces}"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>