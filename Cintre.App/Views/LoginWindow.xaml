<Window x:Class="Cintre.App.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cintré · Connexion" Width="460" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="{StaticResource FondBrush}"
        FontFamily="Segoe UI" FontSize="14" Foreground="{StaticResource TexteBrush}">

    <StackPanel Margin="32">
        <TextBlock Text="Cintré" Style="{StaticResource TitrePage}"
                   HorizontalAlignment="Center" Margin="0,8,0,0"/>
        <TextBlock Text="Connecte-toi pour continuer" Style="{StaticResource Legende}"
                   HorizontalAlignment="Center" Margin="0,8,0,0"/>

        <Border Style="{StaticResource Carte}" Margin="0,24,0,0">
            <StackPanel>
                <TextBlock Text="Identifiant" Style="{StaticResource Legende}" Margin="0,0,0,8"/>
                <TextBox x:Name="TxtLogin" Style="{StaticResource ChampTexte}"
                         Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Mot de passe" Style="{StaticResource Legende}" Margin="0,16,0,8"/>
                <PasswordBox x:Name="TxtMotDePasse" Style="{StaticResource ChampMotDePasse}"/>

                <TextBlock Style="{StaticResource MessageErreur}" Text="{Binding MessageErreur}"/>

                <Button Content="Se connecter" Style="{StaticResource BoutonPrimaire}"
                        IsDefault="True" Margin="0,24,0,0"
                        Command="{Binding ConnecterCommand}"
                        CommandParameter="{Binding ElementName=TxtMotDePasse}"/>
            </StackPanel>
        </Border>
    </StackPanel>
</Window>