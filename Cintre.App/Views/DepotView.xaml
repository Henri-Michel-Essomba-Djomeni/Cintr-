<UserControl x:Class="Cintre.App.Views.DepotView"
    Language="fr-FR"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Version fonctionnelle : seuls les styles TitrePage et Legende sont utilisés.
         La mise en forme finale (styles, couleurs, animations) viendra avec T30. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Titre et progression -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Dépôt" Style="{StaticResource TitrePage}"/>
            <TextBlock Text="{Binding TitreEtape}" Style="{StaticResource Legende}" Margin="0,8,0,4"/>
            <ProgressBar Minimum="0" Maximum="3" Value="{Binding Etape}" Height="8"/>
        </StackPanel>

        <!-- Messages -->
        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock Text="{Binding Erreur}" Foreground="#C0392B" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding Info}" Foreground="#1E8449" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Contenu des 3 étapes -->
        <Grid Grid.Row="3" Margin="0,12,0,12">

            <!-- ÉTAPE 1 : client -->
            <StackPanel Visibility="{Binding EstEtape1, Converter={StaticResource BoolVis}}">
                <TextBlock Text="Rechercher un client (nom ou téléphone)"/>
                <TextBox Text="{Binding Recherche, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8"/>

                <ListBox ItemsSource="{Binding Resultats}" SelectedItem="{Binding ClientChoisi}"
                         MinHeight="140" MaxHeight="260">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="2">
                                <TextBlock Text="{Binding Nom}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Telephone, StringFormat=' · {0}'}" Margin="6,0,0,0"/>
                                <TextBlock Text="{Binding PointsFidelite, StringFormat=' · {0} pts'}" Margin="6,0,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Text="{Binding ResumeClient}" FontWeight="SemiBold" Margin="0,10,0,0"/>

                <Button Content="+ Nouveau client" Command="{Binding BasculerNouveauClientCommand}"
                        HorizontalAlignment="Left" Margin="0,10,0,0" Padding="12,4"/>

                <Border Visibility="{Binding AfficherNouveauClient, Converter={StaticResource BoolVis}}"
                        BorderBrush="Gray" BorderThickness="1" Padding="12" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="Nom"/>
                        <TextBox Text="{Binding NomNouveau, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8"/>
                        <TextBlock Text="Téléphone"/>
                        <TextBox Text="{Binding TelephoneNouveau, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8"/>
                        <Button Content="Enregistrer le client" Command="{Binding CreerClientCommand}"
                                HorizontalAlignment="Left" Padding="12,4"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ÉTAPE 2 : articles -->
            <Grid Visibility="{Binding EstEtape2, Converter={StaticResource BoolVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{Binding ResumeClient}" Style="{StaticResource Legende}"/>

                <WrapPanel Grid.Row="1" Margin="0,8,0,0">
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="Vêtement"/>
                        <ComboBox ItemsSource="{Binding TypesVetement}" SelectedItem="{Binding TypeChoisi}"
                                  DisplayMemberPath="Nom" Width="160"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="Service"/>
                        <ComboBox ItemsSource="{Binding Services}" SelectedItem="{Binding ServiceChoisi}"
                                  DisplayMemberPath="Nom" Width="160"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="Prix"/>
                        <TextBlock Text="{Binding PrixTexte}" FontWeight="SemiBold" Margin="0,4,0,0" MinWidth="90"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="Quantité"/>
                        <TextBox Text="{Binding Quantite, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="Couleur"/>
                        <TextBox Text="{Binding Couleur, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="Remarque"/>
                        <TextBox Text="{Binding RemarqueLigne, UpdateSourceTrigger=PropertyChanged}" Width="200"/>
                    </StackPanel>
                    <Button Content="Ajouter la ligne" Command="{Binding AjouterLigneCommand}"
                            VerticalAlignment="Bottom" Margin="0,0,0,8" Padding="12,4"/>
                </WrapPanel>

                <DataGrid Grid.Row="2" ItemsSource="{Binding Lignes}" AutoGenerateColumns="False"
                          CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column" MinHeight="120">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Vêtement" Binding="{Binding TypeVetementNom}" Width="*"/>
                        <DataGridTextColumn Header="Service" Binding="{Binding ServiceNom}" Width="*"/>
                        <DataGridTextColumn Header="Qté" Binding="{Binding Quantite}"/>
                        <DataGridTextColumn Header="Couleur" Binding="{Binding Couleur}"/>
                        <DataGridTextColumn Header="Prix" Binding="{Binding PrixUnitaire, StringFormat=N0}"/>
                        <DataGridTextColumn Header="Sous-total" Binding="{Binding SousTotal, StringFormat=N0}"/>
                        <DataGridTemplateColumn>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Retirer"
                                            Command="{Binding DataContext.SupprimerLigneCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Grid.Row="3" Text="{Binding SousTotalTexte, StringFormat='Sous-total : {0}'}"
                           FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,10,0,0"/>
            </Grid>

            <!-- ÉTAPE 3 : récapitulatif -->
            <StackPanel Visibility="{Binding EstEtape3, Converter={StaticResource BoolVis}}">
                <TextBlock Text="{Binding ResumeClient}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding ResumeArticles}" Margin="0,4,0,12"/>

                <CheckBox Content="Service urgent (supplément, retrait le lendemain)"
                          IsChecked="{Binding Urgent}" Margin="0,0,0,8"/>
                <CheckBox Content="Utiliser la remise fidélité" IsChecked="{Binding AppliquerRemise}"
                          Visibility="{Binding RemiseDisponible, Converter={StaticResource BoolVis}}" Margin="0,0,0,8"/>

                <TextBlock Text="Remarque générale"/>
                <TextBox Text="{Binding RemarqueGenerale, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" Height="60" Margin="0,2,0,12"/>

                <TextBlock Text="{Binding DatePrevueTexte, StringFormat='Retrait prévu le {0}'}"/>
                <TextBlock Text="{Binding RemiseTexte}" Margin="0,4,0,0"/>
                <TextBlock Text="{Binding TotalTexte, StringFormat='Total à payer : {0}'}"
                           FontSize="22" FontWeight="SemiBold" Margin="0,8,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Navigation -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Précédent" Command="{Binding PrecedentCommand}" Padding="16,6" Margin="0,0,8,0"/>
            <Button Content="Suivant" Command="{Binding SuivantCommand}" Padding="16,6"
                    Visibility="{Binding EstEtapeNonFinale, Converter={StaticResource BoolVis}}"/>
            <Button Content="Valider le dépôt" Command="{Binding ValiderCommand}" Padding="16,6"
                    Visibility="{Binding EstEtape3, Converter={StaticResource BoolVis}}"/>
        </StackPanel>
    </Grid>
</UserControl>
