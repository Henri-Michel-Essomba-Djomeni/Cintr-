<Window x:Class="Cintre.App.Views.ConnexionBaseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Cintre.App.Controls"
        Title="Cintré · Connexion à la base" Width="540" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="{StaticResource FondBrush}"
        FontFamily="Segoe UI" FontSize="14" Foreground="{StaticResource TexteBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVersVisible"/>
    </Window.Resources>

    <StackPanel Margin="32">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Border Width="48" Height="48" CornerRadius="14" Background="{StaticResource PrimaireBrush}">
                <Viewbox Width="26" Height="26">
                    <Canvas Width="24" Height="24">
                        <Path Data="{StaticResource IconCintre}" Stroke="White" StrokeThickness="1.8"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Canvas>
                </Viewbox>
            </Border>
            <TextBlock Text="Cintré" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0,0,0"/>
        </StackPanel>
        <TextBlock Text="Connexion à la base" Style="{StaticResource TitrePage}" Margin="0,4,0,0"/>
        <TextBlock Style="{StaticResource Legende}" TextWrapping="Wrap" Margin="0,6,0,0"
                   Text="Indique l'adresse du serveur PostgreSQL. Sur le PC qui héberge la base, utilise « Je suis l'hôte »."/>

        <Border Style="{StaticResource Carte}" Margin="0,20,0,0">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Hôte" Style="{StaticResource Legende}"/>
                        <TextBox Style="{StaticResource ChampTexte}" Margin="0,4,0,0"
                                 Text="{Binding Hote, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Port" Style="{StaticResource Legende}"/>
                        <TextBox Style="{StaticResource ChampTexte}" Margin="0,4,0,0"
                                 Text="{Binding PortTexte, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Base" Style="{StaticResource Legende}" Margin="0,14,0,0"/>
                <TextBox Style="{StaticResource ChampTexte}" Margin="0,4,0,0"
                         Text="{Binding NomBase, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Utilisateur" Style="{StaticResource Legende}" Margin="0,14,0,0"/>
                <TextBox Style="{StaticResource ChampTexte}" Margin="0,4,0,0"
                         Text="{Binding Utilisateur, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Mot de passe" Style="{StaticResource Legende}" Margin="0,14,0,0"/>
                <PasswordBox x:Name="ChampMdp" Style="{StaticResource ChampMotDePasse}" Margin="0,4,0,0"/>

                <!-- Message du test : vert si réussi, rouge sinon -->
                <Border CornerRadius="8" Padding="12,10" Margin="0,16,0,0"
                        Visibility="{Binding AMessage, Converter={StaticResource BoolVersVisible}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#FBEAEA"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MessageEstSucces}" Value="True">
                                    <Setter Property="Background" Value="#E6F4EC"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MessageEstSucces}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource SuccesBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

                <!-- Adresses de cette machine, à donner aux autres PC -->
                <Border CornerRadius="8" Padding="12,10" Margin="0,16,0,0"
                        Background="{StaticResource SurvolBrush}"
                        Visibility="{Binding AdressesVisibles, Converter={StaticResource BoolVersVisible}}">
                    <StackPanel>
                        <TextBlock Text="Adresses de ce PC" Style="{StaticResource Legende}"/>
                        <ItemsControl ItemsSource="{Binding Adresses}" Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontWeight="SemiBold" Margin="0,2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Actions -->
                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                    <Button Content="Je suis l'hôte" Style="{StaticResource BoutonSecondaire}"
                            Command="{Binding CommandeJeSuisHote}"/>
                    <Button Content="Afficher mon adresse" Style="{StaticResource BoutonSecondaire}"
                            Margin="8,0,0,0" Command="{Binding CommandeAfficherAdresse}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <controls:LoadingSpinner EstActif="{Binding EnCours}" Width="24" Height="24" Margin="0,0,14,0"/>
                    <Button Content="Tester la connexion" Style="{StaticResource BoutonSecondaire}"
                            Command="{Binding CommandeTester}"/>
                    <Button Content="Enregistrer" Style="{StaticResource BoutonPrimaire}"
                            Margin="8,0,0,0" Command="{Binding CommandeEnregistrer}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</Window>