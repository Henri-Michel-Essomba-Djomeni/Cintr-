<UserControl x:Class="Cintre.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Cintre.App.Controls">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVersVisible"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,12,24">

            <!-- En-tête : salutation, date et boutons rapides -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Salutation}" Style="{StaticResource TitrePage}"/>
                    <TextBlock Text="{Binding DateTexte}" Foreground="{StaticResource TexteDiscretBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Retrait" Style="{StaticResource BoutonSecondaire}"
                            Command="{Binding CommandeRetrait}"/>
                    <Button Content="Nouveau dépôt" Style="{StaticResource BoutonPrimaire}"
                            Margin="8,0,0,0" Command="{Binding CommandeNouveauDepot}"/>
                </StackPanel>
            </Grid>

            <!-- Bandeau visible uniquement tant que les services ne sont pas branchés -->
            <Border Background="#FFF6E0" CornerRadius="8" Padding="12,8" Margin="0,16,0,0"
                    Visibility="{Binding DonneesDemo, Converter={StaticResource BoolVersVisible}}">
                <TextBlock Text="Données de démonstration : StatsService ou CommandeRepository ne sont pas encore branchés."
                           FontSize="12" Foreground="{StaticResource TexteBrush}" TextWrapping="Wrap"/>
            </Border>

            <!-- Les 4 cartes de chiffres -->
            <UniformGrid x:Name="Cartes" Columns="4" Margin="0,20,-16,0">
                <Border Style="{StaticResource Carte}" Margin="0,0,16,0">
                    <StackPanel>
                        <TextBlock Text="Dépôts du jour" Style="{StaticResource Legende}"/>
                        <controls:CountUpText Valeur="{Binding DepotsDuJour}" FontSize="32" FontWeight="SemiBold"
                                              Foreground="{StaticResource TexteBrush}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Carte}" Margin="0,0,16,0">
                    <StackPanel>
                        <TextBlock Text="Retraits du jour" Style="{StaticResource Legende}"/>
                        <controls:CountUpText Valeur="{Binding RetraitsDuJour}" FontSize="32" FontWeight="SemiBold"
                                              Foreground="{StaticResource TexteBrush}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <Border x:Name="CarteRecette" Style="{StaticResource Carte}" Margin="0,0,16,0">
                    <StackPanel>
                        <TextBlock Text="Recette du jour" Style="{StaticResource Legende}"/>
                        <WrapPanel Margin="0,6,0,0">
                            <controls:CountUpText Valeur="{Binding RecetteDuJour}" FontSize="28" FontWeight="SemiBold"
                                                  Foreground="{StaticResource PrimaireBrush}"/>
                            <TextBlock Text="FCFA" FontSize="14" Foreground="{StaticResource TexteDiscretBrush}"
                                       VerticalAlignment="Bottom" Margin="6,0,0,4"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Carte rouge qui pulse quand des commandes sont en retard -->
                <Border x:Name="CarteRetard" Margin="0,0,16,0">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Carte}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ARetard}" Value="True">
                                    <Setter Property="Background" Value="#FBEAEA"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="Commandes en retard" Style="{StaticResource Legende}"/>
                        <controls:CountUpText Valeur="{Binding EnRetard}" FontSize="32" FontWeight="SemiBold" Margin="0,6,0,0">
                            <controls:CountUpText.Style>
                                <Style TargetType="controls:CountUpText">
                                    <Setter Property="Foreground" Value="{StaticResource TexteBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ARetard}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </controls:CountUpText.Style>
                        </controls:CountUpText>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Commandes à traiter, les plus anciennes d'abord -->
            <Border Style="{StaticResource Carte}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Commandes à traiter" Style="{StaticResource TitreCarte}"/>
                    <TextBlock Text="Les 5 plus anciennes non terminées" Style="{StaticResource Legende}" Margin="0,2,0,0"/>

                    <ItemsControl ItemsSource="{Binding Commandes}" Margin="0,12,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource SeparateurBrush}" BorderThickness="0,1,0,0" Padding="0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.2*"/>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="150"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Ticket}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Client}" Style="{StaticResource Legende}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <controls:ConveyorStatus Grid.Column="1" Statut="{Binding Statut}" Margin="12,0"/>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Echeance}" TextAlignment="Right" FontSize="12">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource TexteBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding EnRetard}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Montant}" Style="{StaticResource Legende}"
                                                       TextAlignment="Right" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <controls:EmptyState MinHeight="320"
                                         Titre="Aucune commande en cours"
                                         Message="Les commandes en attente apparaîtront ici."
                                         Icone="{StaticResource IconCommandes}"
                                         Visibility="{Binding AucuneCommande, Converter={StaticResource BoolVersVisible}}">
                        <controls:EmptyState.ContenuAction>
                            <Button Content="Nouveau dépôt" Style="{StaticResource BoutonPrimaire}"
                                    Click="NouveauDepot_Click"/>
                        </controls:EmptyState.ContenuAction>
                    </controls:EmptyState>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>