<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageReference Include="Dapper" Version="2.1.100" />
    <PackageReference Include="Npgsql" Version="11.0.0" />
  </ItemGroup>

  <!-- Les scripts SQL sont embarqués dans l'exécutable : DatabaseInitializer les lit sans dépendre d'un dossier -->
  <ItemGroup>
    <EmbeddedResource Include="..\Database\schema.sql" LogicalName="schema.sql" />
    <EmbeddedResource Include="..\Database\seed.sql" LogicalName="seed.sql" />
  </ItemGroup>

</Project>
