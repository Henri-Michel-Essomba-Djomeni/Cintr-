<UserControl x:Class="Cintre.App.Controls.LoadingSpinner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="32" Height="32">
    <Grid RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <RotateTransform x:Name="Rotation" Angle="0"/>
        </Grid.RenderTransform>
        <Ellipse Margin="2" Stroke="{StaticResource SeparateurBrush}" StrokeThickness="3"/>
        <Canvas Width="32" Height="32">
            <Path Data="M 16,2 A 14,14 0 0 1 30,16" Stroke="{StaticResource PrimaireBrush}" StrokeThickness="3"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        </Canvas>
    </Grid>
</UserControl>