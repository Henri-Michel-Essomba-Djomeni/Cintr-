<UserControl x:Class="Cintre.App.Controls.HangerBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="72" MinWidth="200">
    <Grid>
        <!-- La tringle -->
        <Border x:Name="Tringle" Height="4" CornerRadius="2" VerticalAlignment="Top"/>
        <!-- Les cintres, répartis régulièrement -->
        <UniformGrid x:Name="Cintres" Rows="1" Margin="16,1,16,0"/>
    </Grid>
</UserControl>