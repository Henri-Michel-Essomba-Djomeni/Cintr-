<UserControl x:Class="Cintre.App.Controls.ConveyorStatus"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Racine" MinWidth="260" SizeChanged="Racine_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Le tapis, et la partie déjà parcourue -->
        <Border Height="6" CornerRadius="3" Background="{StaticResource SeparateurBrush}"
                VerticalAlignment="Bottom" Margin="0,0,0,2"/>
        <Border x:Name="Progression" Width="0" Height="6" CornerRadius="3"
                Background="{StaticResource StatutRecuBrush}"
                HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,0,0,2"/>

        <!-- Les 4 étapes -->
        <UniformGrid Columns="4" VerticalAlignment="Bottom" Margin="0,0,0,-2">
            <Ellipse x:Name="Point0" Width="14" Height="14" StrokeThickness="2" Fill="White"/>
            <Ellipse x:Name="Point1" Width="14" Height="14" StrokeThickness="2" Fill="White"/>
            <Ellipse x:Name="Point2" Width="14" Height="14" StrokeThickness="2" Fill="White"/>
            <Ellipse x:Name="Point3" Width="14" Height="14" StrokeThickness="2" Fill="White"/>
        </UniformGrid>

        <!-- Le vêtement qui glisse sur le tapis -->
        <Canvas IsHitTestVisible="False">
            <Border x:Name="Vetement" Canvas.Top="0" Width="34" Height="34" CornerRadius="17"
                    Background="{StaticResource StatutRecuBrush}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.25" Color="#000000"/>
                </Border.Effect>
                <Border.RenderTransform>
                    <TranslateTransform x:Name="Deplacement" X="0"/>
                </Border.RenderTransform>
                <Viewbox Width="18" Height="18">
                    <Canvas Width="24" Height="24">
                        <Path Data="{StaticResource IconCintre}" Stroke="White" StrokeThickness="2"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Canvas>
                </Viewbox>
            </Border>
        </Canvas>

        <!-- Les noms des étapes -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,10,0,0">
            <TextBlock x:Name="Etape0" Text="Reçu" FontSize="12" HorizontalAlignment="Center"/>
            <TextBlock x:Name="Etape1" Text="Traitement" FontSize="12" HorizontalAlignment="Center"/>
            <TextBlock x:Name="Etape2" Text="Prêt" FontSize="12" HorizontalAlignment="Center"/>
            <TextBlock x:Name="Etape3" Text="Retiré" FontSize="12" HorizontalAlignment="Center"/>
        </UniformGrid>
    </Grid>
</UserControl>