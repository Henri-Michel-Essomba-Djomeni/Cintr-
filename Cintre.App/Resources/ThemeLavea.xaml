<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Style Lavea : bleu pétrole et jaune sable. Utilisé seulement par les écrans de Raïssa
         (Clients, Tarifs, Statistiques). Aucune clé ne remplace celles de Colors.xaml. -->
    <SolidColorBrush x:Key="LavPetrolNuitBrush" Color="#06303B"/>
    <SolidColorBrush x:Key="LavPetrolBrush" Color="#0B4F60"/>
    <SolidColorBrush x:Key="LavPetrolClairBrush" Color="#0F6677"/>
    <SolidColorBrush x:Key="LavSableBrush" Color="#E9C46A"/>
    <SolidColorBrush x:Key="LavSableClairBrush" Color="#F4DFA3"/>
    <SolidColorBrush x:Key="LavCremeBrush" Color="#FBF4E0"/>
    <SolidColorBrush x:Key="LavChampBrush" Color="#FFFDF6"/>
    <SolidColorBrush x:Key="LavEncreBrush" Color="#0B3C49"/>
    <SolidColorBrush x:Key="LavDiscretBrush" Color="#4A6772"/>
    <SolidColorBrush x:Key="LavPaleBrush" Color="#CFE3E8"/>
    <SolidColorBrush x:Key="LavBordureBrush" Color="#D9CFAE"/>
    <SolidColorBrush x:Key="LavSurvolBrush" Color="#F7EDCD"/>
    <SolidColorBrush x:Key="LavSelectionBrush" Color="#F4E3B0"/>
    <SolidColorBrush x:Key="LavDangerBrush" Color="#8C3A28"/>

    <!-- ===================== TEXTES ===================== -->
    <Style x:Key="LavTitre" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
        <Setter Property="FontSize" Value="30"/>
        <Setter Property="Foreground" Value="{StaticResource LavCremeBrush}"/>
    </Style>

    <Style x:Key="LavSousTitre" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource LavPaleBrush}"/>
    </Style>

    <Style x:Key="LavTitreCarte" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="Foreground" Value="{StaticResource LavEncreBrush}"/>
    </Style>

    <Style x:Key="LavLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource LavDiscretBrush}"/>
        <Setter Property="Margin" Value="0,14,0,5"/>
    </Style>

    <Style x:Key="LavTexteDiscret" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource LavDiscretBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- Message d'erreur : disparaît quand il est vide -->
    <Style x:Key="LavErreur" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource LavDangerBrush}"/>
        <Setter Property="Margin" Value="2,5,0,0"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===================== CARTE ===================== -->
    <Style x:Key="LavCarte" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource LavCremeBrush}"/>
        <Setter Property="CornerRadius" Value="22"/>
        <Setter Property="Padding" Value="26"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.30" Color="#000000"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LavBadge" TargetType="Border">
        <Setter Property="Background" Value="#E8DDB8"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="9,2"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ===================== BOUTONS ===================== -->
    <Style x:Key="LavBouton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource LavPetrolBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource LavCremeBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="MinHeight" Value="42"/>
        <Setter Property="Padding" Value="22,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="fond" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="12" SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="fond" Property="Opacity" Value="0.88"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="fond" Property="Opacity" Value="0.75"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="fond" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LavBoutonSable" TargetType="Button" BasedOn="{StaticResource LavBouton}">
        <Setter Property="Background" Value="{StaticResource LavSableBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource LavEncreBrush}"/>
    </Style>

    <Style x:Key="LavBoutonContour" TargetType="Button" BasedOn="{StaticResource LavBouton}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource LavDangerBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource LavDangerBrush}"/>
    </Style>

    <!-- ===================== CHAMPS ===================== -->
    <Style x:Key="LavChamp" TargetType="TextBox">
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="MinHeight" Value="42"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource LavEncreBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="bord" Background="{StaticResource LavChampBrush}"
                            BorderBrush="{StaticResource LavBordureBrush}" BorderThickness="1.5"
                            CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bord" Property="BorderBrush" Value="{StaticResource LavPetrolClairBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bord" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LavCase" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource LavEncreBrush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="boite" Width="22" Height="22" CornerRadius="6" BorderThickness="1.5"
                                BorderBrush="{StaticResource LavBordureBrush}"
                                Background="{StaticResource LavChampBrush}" VerticalAlignment="Center">
                            <Path x:Name="coche" Data="M5,11 L9,15 L17,6" Stroke="{StaticResource LavSableBrush}"
                                  StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="boite" Property="Background" Value="{StaticResource LavPetrolBrush}"/>
                            <Setter TargetName="boite" Property="BorderBrush" Value="{StaticResource LavPetrolBrush}"/>
                            <Setter TargetName="coche" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== LISTES ===================== -->
    <Style x:Key="LavLigneListe" TargetType="ListBoxItem">
        <Setter Property="Margin" Value="0,0,0,4"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="fond" Background="Transparent" CornerRadius="12" Padding="14,10">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="fond" Property="Background" Value="{StaticResource LavSurvolBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="fond" Property="Background" Value="{StaticResource LavSelectionBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LavListe" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource LavLigneListe}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>

    <!-- ===================== ONGLETS (sur fond pétrole) ===================== -->
    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource LavPaleBrush}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="fond" Background="Transparent" Padding="18,12" Margin="0,0,8,-1"
                            BorderBrush="Transparent" BorderThickness="0,0,0,3">
                        <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource LavCremeBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource LavSableBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter TargetName="fond" Property="BorderBrush" Value="{StaticResource LavSableBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border BorderBrush="#33FFFFFF" BorderThickness="0,0,0,1">
                            <TabPanel IsItemsHost="True" Panel.ZIndex="1"/>
                        </Border>
                        <ContentPresenter Grid.Row="1" ContentSource="SelectedContent" Margin="0,20,0,0"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
